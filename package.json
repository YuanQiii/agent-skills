{
  "name": "agent-skills-sync",
  "version": "3.0.0",
  "description": "Agent skills 本地同步工具 - 监视文件变化并自动同步到 GitHub",
  "type": "module",
  "main": "dist/watcher.js",
  "scripts": {
    "build": "tsc",
    "sync": "node dist/cli/sync.js",
    "watch": "node dist/watcher.js",
    "catalog": "node dist/catalog.js",
    "translate": "node dist/cli/translate.js",
    "dev:sync": "tsx src/cli/sync.ts",
    "dev:watch": "tsx src/watcher.ts",
    "dev:catalog": "tsx src/catalog.ts",
    "dev:translate": "tsx src/cli/translate.ts"
  },
  "keywords": ["agent", "skills", "sync", "git"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
